#!/usr/bin/python3
import customtkinter as ctk
import subprocess
import threading
from pathlib import Path
from datetime import datetime
from tkinter import messagebox


LOG_PATH = Path("/tmp/holoiso-installer.log")


class App(ctk.CTk):
    def __init__(self):
        super().__init__()

        self.title("HoloISO Installer")
        self.geometry("700x450")
        self.minsize(650, 400)
        self.after(1, self.center_window)
        
        ctk.set_appearance_mode("dark")
        ctk.set_default_color_theme("blue")

        self.current_drive = None
        self.process = None
        self.install_running = False

        LOG_PATH.write_text(
            f"HoloISO Installer Log\nStarted: {datetime.now()}\n\n",
            encoding="utf-8",
        )

        self.create_ui()

    def center_window(self):
        self.update_idletasks()

        width = 700
        height = 450

        x = (self.winfo_screenwidth() // 2) - (width // 2)
        y = (self.winfo_screenheight() // 2) - (height // 2)

        self.geometry(f"{width}x{height}+{x}+{y}")

    def create_ui(self):
        self.tabview = ctk.CTkTabview(self, command=self.page_event, state="disabled", text_color_disabled="white")
        self.tabview.pack(fill="both", expand=True, padx=12, pady=(12, 6))

        self.tabs = [
            "Welcome",
            "Drive Selection",
            "User Setup",
            "Additional Options",
            "Summary",
            "Installation",
            "Finish",
        ]

        for tab in self.tabs:
            self.tabview.add(tab)
        self.build_welcome_tab()
        self.build_drive_tab()
        self.build_user_tab()
        self.build_additional_tab()
        self.build_summary_tab()
        self.build_install_tab()
        self.build_finish_tab()
        self.build_navbar()
        
    def build_navbar(self):
        self.navbar = ctk.CTkFrame(self, height=52)
        self.navbar.pack(fill="x", padx=12, pady=(0, 12))

        self.exit_btn = ctk.CTkButton(
            self.navbar,
            text="Exit",
            command=self.exit,
            width=100,
        )
        self.exit_btn.pack(side="left", padx=8, pady=10)

        self.next_btn = ctk.CTkButton(
            self.navbar,
            text="Next",
            command=self.go_next,
            width=100,
        )
        self.next_btn.pack(side="right", padx=8, pady=10)

        self.back_btn = ctk.CTkButton(
            self.navbar,
            text="Back",
            command=self.go_back,
            width=100,
        )
        self.back_btn.pack(side="right", padx=8, pady=10)

        self.log_btn = ctk.CTkButton(
            self.navbar,
            text="Open Log",
            command=self.open_log_window,
            width=100,
        )
        self.log_btn.pack(side="right", padx=8, pady=10)
        self.log_btn.pack_forget()

        self.update_navbar()
        
    def build_welcome_tab(self):
        tab = self.tabview.tab("Welcome")
        tab.grid_columnconfigure(0, weight=1)
        tab.grid_rowconfigure(1, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Welcome to the HoloISO Installer",
            font=ctk.CTkFont(size=24, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(35, 10))

        desc = ctk.CTkLabel(
            tab,
            text=(
                "This wizard will guide you through installing HoloISO.\n\n"
                "Make sure you backed up important data before continuing."
            ),
            font=ctk.CTkFont(size=15),
            justify="center",
        )
        desc.grid(row=1, column=0, padx=30, pady=10)

    def build_drive_tab(self):
        tab = self.tabview.tab("Drive Selection")
        tab.grid_columnconfigure(0, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Select Installation Drive",
            font=ctk.CTkFont(size=22, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(30, 10))

        self.drive_option = ctk.CTkOptionMenu(
            tab,
            values=["No drives loaded"],
            command=self.drive_selected,
            width=350,
        )
        self.drive_option.grid(row=1, column=0, padx=20, pady=20)

        refresh_btn = ctk.CTkButton(
            tab,
            text="Refresh Drives",
            command=self.refresh_drives,
        )
        refresh_btn.grid(row=2, column=0, pady=10)

        warning = ctk.CTkLabel(
            tab,
            text="Warning: the selected drive may be erased during installation.",
            text_color="orange",
        )
        warning.grid(row=3, column=0, padx=20, pady=15)

        self.refresh_drives()

    def build_user_tab(self):
        tab = self.tabview.tab("User Setup")
        tab.grid_columnconfigure(0, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="User Setup",
            font=ctk.CTkFont(size=22, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(30, 10))
        
        self.username = ctk.CTkEntry(
            tab,
            placeholder_text="Username",
            font=ctk.CTkFont(size=15),
        )
        self.username.grid(row=1, column=0, padx=30, pady=10)
        self.password = ctk.CTkEntry(
            tab,
            placeholder_text="Password",
            font=ctk.CTkFont(size=15),
        )
        self.password.grid(row=2, column=0, padx=30, pady=10)
        self.confirm_password = ctk.CTkEntry(
            tab,
            placeholder_text="Confirm password",
            font=ctk.CTkFont(size=15),
        )
        self.confirm_password.grid(row=3, column=0, padx=30, pady=10)
        self.enable_root = ctk.CTkCheckBox(
            tab,
            text="Enable root login? (not recommended)",
            font=ctk.CTkFont(size=15),
            state="disabled",
            
        )
        self.enable_root.select()
        self.enable_root.grid(row=4, column=0, padx=30, pady=10)
        desc = ctk.CTkLabel(
            tab,
            text="Note: The same password will be set for both the user and root accounts.",
            font=ctk.CTkFont(size=12),
            text_color="orange",
            justify="center",
        )
        desc.grid(row=5, column=0, padx=30, pady=10)
        desc.grid_forget()


    def build_additional_tab(self):
        tab = self.tabview.tab("Additional Options")
        tab.grid_columnconfigure(0, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Additional Options",
            font=ctk.CTkFont(size=22, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(30, 10))

        desc = ctk.CTkLabel(
            tab,
            text="This section is reserved for future use.",
            font=ctk.CTkFont(size=15),
            justify="center",
        )
        desc.grid(row=1, column=0, padx=30, pady=10)
        
    def build_summary_tab(self):
        tab = self.tabview.tab("Summary")
        tab.grid_columnconfigure(0, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Summary",
            font=ctk.CTkFont(size=22, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(30, 10))

        desc = ctk.CTkLabel(
            tab,
            text="This section is reserved for future use.",
            font=ctk.CTkFont(size=15),
            justify="center",
        )
        desc.grid(row=1, column=0, padx=30, pady=10)

    def build_install_tab(self):
        tab = self.tabview.tab("Installation")
        tab.grid_columnconfigure(0, weight=1)
        tab.grid_rowconfigure(2, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Installation",
            font=ctk.CTkFont(size=22, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(30, 10))

        self.progress = ctk.CTkProgressBar(tab, width=420)
        self.progress.set(0)
        self.progress.grid(row=1, column=0, padx=20, pady=20)

        self.log_box = ctk.CTkTextbox(tab, width=520, height=170)
        self.log_box.grid(row=2, column=0, padx=20, pady=10, sticky="nsew")
        self.log("Installer ready.")

    def build_finish_tab(self):
        tab = self.tabview.tab("Finish")
        tab.grid_columnconfigure(0, weight=1)
        tab.grid_rowconfigure(1, weight=1)

        title = ctk.CTkLabel(
            tab,
            text="Installation Complete",
            font=ctk.CTkFont(size=24, weight="bold"),
        )
        title.grid(row=0, column=0, padx=20, pady=(50, 10))

        desc = ctk.CTkLabel(
            tab,
            text="HoloISO has finished installing.\nYou can now reboot your system.",
            font=ctk.CTkFont(size=15),
            justify="center",
        )
        desc.grid(row=1, column=0, padx=30, pady=10)

        nav = ctk.CTkFrame(tab, fg_color="transparent")
        nav.grid(row=2, column=0, pady=30)

        log_btn = ctk.CTkButton(
            nav,
            text="Open Log",
            command=self.open_log_window,
        )
        log_btn.grid(row=0, column=0, padx=8)

        close_btn = ctk.CTkButton(
            nav,
            text="Close",
            command=self.destroy,
        )
        close_btn.grid(row=0, column=1, padx=8)

    def page_event(self):
        print(f"Switched to: {self.tabview.get()}")

    def drive_selected(self, drive):
        self.current_drive = drive
        self.log(f"Selected drive: {drive}")

    def refresh_drives(self):
        try:
            result = subprocess.run(
                ["lsblk", "-n", "-o", "NAME,SIZE,MODEL", "-d"],
                capture_output=True,
                text=True,
                check=True,
            )

            drives = []
            for line in result.stdout.splitlines():
                parts = line.split(maxsplit=1)
                if parts:
                    name = parts[0]
                    info = parts[1] if len(parts) > 1 else ""
                    drives.append(f"/dev/{name} - {info}")

            if not drives:
                drives = ["No drives loaded"]

            self.drive_option.configure(values=drives)
            self.drive_option.set(drives[0])
            self.current_drive = drives[0]

        except subprocess.CalledProcessError:
            self.drive_option.configure(values=["No drives loaded"])
            self.drive_option.set("No drives loaded")
            self.current_drive = None

    def get_drive_device(self):
        if not self.current_drive:
            return None

        if self.current_drive == "No drives loaded":
            return None

        return self.current_drive.split(" - ")[0]

    def start_installation(self):
        drive = self.get_drive_device()

        if not drive:
            self.log("No drive selected.")
            return

        confirm = messagebox.askyesno(
            "Confirm Installation",
            f"Are you sure?\n\nAll contents on {drive} may be erased.",
        )

        if not confirm:
            self.log("Installation cancelled.")
            return

        self.install_btn.configure(state="disabled")
        self.install_running = True
        self.progress.set(0.05)

        self.log("Starting installation...")
        self.log(f"Target drive: {drive}")

        thread = threading.Thread(
            target=self.run_installer,
            args=(drive,),
            daemon=True,
        )
        thread.start()

    def run_installer(self, drive):
        command = [
            "holoiso_installer",
            "--drive",
            drive.replace("/dev/", ""),
            "--username", self.username.get(),
            "--password", self.password.get(),
            "--root_password", self.password.get(),
        ]

        try:
            self.process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )

            for line in self.process.stdout:
                self.after(0, self.log, line.rstrip())

            exit_code = self.process.wait()

            if exit_code == 0:
                self.after(0, self.install_success)
            else:
                self.after(0, self.install_failed, exit_code)

        except FileNotFoundError:
            self.after(0, self.install_error, "holoiso_installer command not found.")
        except Exception as e:
            self.after(0, self.install_error, str(e))

    def install_success(self):
        self.install_running = False
        self.progress.set(1.0)
        self.log("Installation finished.")
        self.goto_tab("Finish")

    def install_failed(self, exit_code):
        self.install_running = False
        self.progress.set(0)
        self.install_btn.configure(state="normal")
        self.log(f"Installation failed with exit code {exit_code}.")

    def install_error(self, error):
        self.install_running = False
        self.progress.set(0)
        self.install_btn.configure(state="normal")
        self.log(f"Installation error: {error}")

    def log(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        line = f"[{timestamp}] {message}"

        with LOG_PATH.open("a", encoding="utf-8") as file:
            file.write(line + "\n")

        if hasattr(self, "log_box"):
            self.log_box.insert("end", line + "\n")
            self.log_box.see("end")

    def open_log_window(self):
        win = ctk.CTkToplevel(self)
        win.title("Installer Log")
        win.geometry("750x500")

        text = ctk.CTkTextbox(win)
        text.pack(fill="both", expand=True, padx=10, pady=10)

        try:
            text.insert("end", LOG_PATH.read_text(encoding="utf-8", errors="replace"))
        except FileNotFoundError:
            text.insert("end", "No log found.")

        text.configure(state="disabled")

    def current_tab_index(self):
        return self.tabs.index(self.tabview.get())

    def go_back(self):
        index = self.current_tab_index()

        if index > 0:
            self.goto_tab(self.tabs[index - 1])

    def go_next(self):
        tab = self.tabview.get()

        if tab == "Summary":
            self.goto_tab("Installation")
            self.start_installation()
            return

        index = self.current_tab_index()

        if index < len(self.tabs) - 1:
            self.goto_tab(self.tabs[index + 1])

    def goto_tab(self, name):
        self.tabview.set(name)
        self.update_navbar()

    def update_navbar(self):
        tab = self.tabview.get()

        self.back_btn.configure(state="normal")
        self.next_btn.configure(state="normal", text="Next")

        if self.install_running:
            self.back_btn.configure(state="disabled")
            self.next_btn.configure(state="disabled")
            return

        if tab == "Welcome":
            self.back_btn.configure(state="disabled")
            self.next_btn.configure(text="Start")

        elif tab == "Summary":
            self.next_btn.configure(text="Install")

        elif tab == "Installation":
            self.back_btn.configure(state="disabled")
            self.next_btn.configure(state="disabled")
            self.log_btn.pack(side="right", padx=8, pady=10)

        elif tab == "Finish":
            self.back_btn.configure(state="disabled")
            self.next_btn.configure(state="disabled")
            self.log_btn.pack(side="right", padx=8, pady=10)
        
    def exit(self):
        if self.install_running or self.process:
            confirm = messagebox.askyesno(
                "Confirm Exit",
                "An installation is currently running.\nAre you sure you want to exit?",
            )

            if not confirm:
                return

            if self.process and self.process.poll() is None:
                self.process.terminate()

        self.destroy()

if __name__ == "__main__":
    app = App()
    app.mainloop()